<Project Sdk="Aspire.AppHost.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The Aspire CLI bundle needs a machine-wide install of the Aspire CLI. The host starts its projects without it. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Orders.Api/Orders.Api.csproj" />
    <ProjectReference Include="../Payments.Api/Payments.Api.csproj" />
  </ItemGroup>

</Project>
